{
  "unit_name": "Voyager-1",
  "unit_id": "VOY-RV-001",
  "platform": "riding",
  "hardware": {
    "drive": {
      "type": "clutch",
      "gears": 7,
      "max_speed_kmh": 15.0,
      "turn_radius_m": 1.5
    },
    "deck": {
      "width_inches": 42,
      "type": "pto",
      "height_adjustable": true
    },
    "operator_presence": {
      "type": "seat_sensor",
      "required_for_auto": true
    },
    "cameras": 5,
    "camera_config": [
      {"name": "front",       "id": 0, "fov": 120},
      {"name": "front_left",  "id": 1, "fov": 90},
      {"name": "front_right", "id": 2, "fov": 90},
      {"name": "rear_left",   "id": 3, "fov": 90},
      {"name": "rear_right",  "id": 4, "fov": 90}
    ],
    "pico_bridge": {
      "port": "/dev/ttyACM0",
      "baud_rate": 115200
    },
    "power": {
      "type": "gas",
      "min_voltage_v": 11.0,
      "nominal_voltage_v": 12.6
    }
  },
  "navigation": {
    "max_speed_kmh": 15.0,
    "turn_radius_m": 1.5,
    "gps_accuracy_threshold_m": 0.02
  },
  "safety": {
    "estop_physical": true,
    "estop_remote": true,
    "watchdog_timeout_ms": 500
  }
}
